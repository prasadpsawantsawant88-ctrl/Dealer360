# Dealer360 runs on local synthetic JSON data. Nothing here is required for the demo.

# Optional: written coaching from Claude on the Pitch Training page.
# Copy this file to .env.local, set the key, then restart `npm run dev`.
# Without a key the page still scores the pitch locally in the browser.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
